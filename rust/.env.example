# Documentation only: this file is NOT automatically loaded.
SLIMS_ADDR=0.0.0.0:8080
SLIMS_DB=memory
SLIMS_HTTP_MAX_CONNECTIONS=128
SLIMS_HTTP_MAX_REQUESTS=100
SLIMS_HTTP_READ_SECONDS=15
SLIMS_HTTP_WRITE_SECONDS=15
SLIMS_HTTP_ACCESS_LOG=1
# Member and all write/demo flags remain OFF unless explicitly enabled.
SLIMS_MEMBER_EXPERIMENTAL=0
SLIMS_MEMBER_TEST_WRITES=0
SLIMS_MEMBER_TEST_RESERVATIONS=0
# Real database credentials belong in a protected service environment, not Git.
